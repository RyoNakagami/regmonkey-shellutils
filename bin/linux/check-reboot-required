#!/bin/bash
# -----------------------------------------------------------------------------
# Author: Ryo Nakagami
# Revised: 2026-06-15
# Script: check-reboot-required
# Description:
#   This script reports the Debian/Ubuntu packages that triggered a pending
#   reboot, enriched with their dpkg install/upgrade history.
#
#   Steps:
#     1. Parse command-line options.
#     2. Verify required commands are available.
#     3. If no reboot-required package list exists, report that no reboot
#        is required and exit.
#     4. For each unique package, find its latest dpkg install/upgrade entry
#        to derive the before/after version and timestamp (falling back to
#        the currently installed version when no log entry is found).
#     5. Print the result as an aligned table.
#
# Options:
#   -v, --version    Show version and exit
#   -h, --help       Show this help message and exit
#
# Usage:
#   check-reboot-required          # List packages awaiting a reboot
#
# Notes:
#   - Targets Debian/Ubuntu (reads /var/run/reboot-required.pkgs).
#   - Requires `sort`, `uniq`, `awk`, `zgrep`, `dpkg-query`, and `column`.
#   - The package-list file and dpkg log glob can be overridden via the
#     REBOOT_PKGS_FILE and DPKG_LOG_GLOB environment variables (used for
#     testing without root or real system state).
#   - Sources '../../lib/docstring.sh' and '../../lib/version.sh'.
# -----------------------------------------------------------------------------

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../../lib/docstring.sh"
source "${SCRIPT_DIR}/../../lib/version.sh"

REBOOT_PKGS_FILE="${REBOOT_PKGS_FILE:-/var/run/reboot-required.pkgs}"
DPKG_LOG_GLOB="${DPKG_LOG_GLOB:-/var/log/dpkg.log*}"

# パッケージ pkg の最新 install/upgrade ログ 1 行を返す（無ければ空）。
# zgrep のマッチ無し (exit 1) は正常系なので set -e で落とさない。
latest_dpkg_entry() {
    local pkg="$1"
    # shellcheck disable=SC2086
    { zgrep -h -E "(install|upgrade) ${pkg}:" ${DPKG_LOG_GLOB} 2>/dev/null || true; } \
        | sort -k1,1 -k2,2 | tail -1
}

# reboot 待ちパッケージの一覧を tab 区切りで出力する。
collect_reboot_packages() {
    printf "PACKAGE\tBEFORE\tAFTER\tLATEST_INSTALL_TIME\n"

    local pkg log_entry latest_install_time action before after
    while read -r pkg; do
        pkg="${pkg#"${pkg%%[![:space:]]*}"}"
        pkg="${pkg%"${pkg##*[![:space:]]}"}"
        if [[ -z "${pkg}" ]]; then
            continue
        fi

        log_entry="$(latest_dpkg_entry "${pkg}")"

        if [[ -n "${log_entry}" ]]; then
            latest_install_time="$(awk '{print $1, $2}' <<< "${log_entry}")"
            action="$(awk '{print $3}' <<< "${log_entry}")"
            if [[ "${action}" == "upgrade" ]]; then
                before="$(awk '{print $(NF-1)}' <<< "${log_entry}")"
            else
                before="(none)"
            fi
            after="$(awk '{print $NF}' <<< "${log_entry}")"
        else
            latest_install_time="N/A"
            before="N/A"
            after="$(dpkg-query -W -f='${Version}' "${pkg}" 2>/dev/null || echo "N/A")"
        fi

        printf "%s\t%s\t%s\t%s\n" "${pkg}" "${before}" "${after}" "${latest_install_time}"
    done < <(sort "${REBOOT_PKGS_FILE}" | uniq)
}

# メイン処理
main() {
    local args=()
    local arg
    for arg in "$@"; do
        case "${arg}" in
            --help)    args+=("-h") ;;
            --version) args+=("-v") ;;
            *)         args+=("${arg}") ;;
        esac
    done

    OPTIND=1
    while getopts ":hv" opt "${args[@]}"; do
        case "${opt}" in
            h)
                usage_helper "$0"
                exit 0
                ;;
            v)
                print_version
                exit 0
                ;;
            \?)
                echo "Error: unknown option: -${OPTARG}" >&2
                echo "Use --help for usage information." >&2
                exit 1
                ;;
        esac
    done
    shift $((OPTIND - 1))

    if [[ $# -gt 0 ]]; then
        echo "Error: unexpected argument: $1" >&2
        echo "Use --help for usage information." >&2
        exit 1
    fi

    local cmd
    for cmd in sort uniq awk zgrep dpkg-query column; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "Error: required command not found: ${cmd}" >&2
            exit 1
        fi
    done

    if [[ ! -f "${REBOOT_PKGS_FILE}" ]]; then
        echo "no reboot required"
        return 0
    fi

    collect_reboot_packages | column -t -s $'\t'
}

main "$@"
