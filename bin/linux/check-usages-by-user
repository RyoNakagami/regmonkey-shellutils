#!/bin/bash
# -----------------------------------------------------------------------------
# Author: Ryo Nakagami
# Revised: 2026-06-12
# Script: check-usages-by-user
# Description:
#   Display CPU and memory usage statistics aggregated by user, along with
#   each user's top CPU-consuming process. CPU percentages are normalized
#   by the number of CPU cores.
#
#   Steps:
#     1. Get the CPU core count with nproc.
#     2. Aggregate %cpu / %mem per UID from 'ps -eo uid,%cpu,%mem,comm'.
#     3. Sort users by CPU% (default) or memory% in descending order.
#     4. Resolve each UID to a username via 'getent passwd'
#        (falls back to 'uid:<uid>' when unresolved).
#     5. Print the result as a table or JSON.
#
# Options:
#   -m, --memory     Sort by memory usage instead of CPU usage
#   -n, --top <N>    Show only the top N users (N must be a positive integer)
#   -j, --json       Output in JSON format
#   -v, --version    Show version and exit
#   -h, --help       Show this help message and exit
#
# Usage:
#   check-usages-by-user             # All users, sorted by CPU% (descending)
#   check-usages-by-user -m -n 5     # Top 5 users by memory usage
#   check-usages-by-user -j          # JSON output
#
# Notes:
#   - Requires ps, nproc, getent, and awk (Linux / procps).
#   - CPU% is the sum of per-process %cpu divided by the core count.
#   - Sources '../../lib/docstring.sh' and '../../lib/version.sh'.
# -----------------------------------------------------------------------------

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../../lib/docstring.sh"
source "${SCRIPT_DIR}/../../lib/version.sh"

# UID 毎に %cpu / %mem を集約し、'uid|cpu|mem|top_process' を出力する。
# CPU はコア数で正規化する。
collect_usage() {
    local cores="$1"
    ps -eo uid,%cpu,%mem,comm --no-headers | awk -v cores="${cores}" '
    {
        uid = $1
        cpu_val = $2
        mem_val = $3
        comm = $4
        for (i = 5; i <= NF; i++) comm = comm " " $i

        cpu[uid] += cpu_val
        mem[uid] += mem_val

        if (!(uid in top_proc) || cpu_val > max_cpu[uid]) {
            max_cpu[uid] = cpu_val
            top_proc[uid] = comm
        }
    }
    END {
        for (uid in cpu) {
            printf "%s|%.2f|%.2f|%s\n", uid, cpu[uid] / cores, mem[uid], top_proc[uid]
        }
    }'
}

# UID をユーザー名に解決する。未解決なら 'uid:<uid>' を返す。
resolve_user() {
    local uid="$1"
    local passwd_line
    if passwd_line="$(getent passwd "${uid}")" && [[ -n "${passwd_line}" ]]; then
        printf '%s' "${passwd_line%%:*}"
    else
        printf 'uid:%s' "${uid}"
    fi
}

# テーブル形式で出力（stdin: 'uid|cpu|mem|top_process'）
output_table() {
    printf "\n%-32s %12s %12s %25s\n" "USER (UID)" "CPU%" "MEMORY%" "TOP PROCESS"
    printf '%s\n' "--------------------------------------------------------------------------------"

    local uid cpu mem proc user_name
    while IFS='|' read -r uid cpu mem proc; do
        user_name="$(resolve_user "${uid}")"
        printf "%-32s %11s%% %11s%% %25s\n" \
            "${user_name} (${uid})" "${cpu}" "${mem}" "${proc}"
    done
}

# JSON形式で出力（stdin: 'uid|cpu|mem|top_process'）
output_json() {
    local entries=()
    local uid cpu mem proc user_name

    while IFS='|' read -r uid cpu mem proc; do
        user_name="$(resolve_user "${uid}")"
        entries+=("$(cat <<EOF
  {
    "username": "${user_name}",
    "uid": ${uid},
    "cpu_percent": ${cpu},
    "mem_percent": ${mem},
    "top_process": "${proc}"
  }
EOF
)")
    done

    echo "["
    local i
    for i in "${!entries[@]}"; do
        if (( i > 0 )); then
            echo ","
        fi
        echo -n "${entries[${i}]}"
    done
    if (( ${#entries[@]} > 0 )); then
        echo
    fi
    echo "]"
}

# メイン処理
main() {
    local sort_key="cpu"
    local output_format="table"
    local top_n=""

    # 長いオプションを短いオプションに変換
    local args=()
    for arg in "$@"; do
        case "${arg}" in
            --help)    args+=("-h") ;;
            --version) args+=("-v") ;;
            --memory)  args+=("-m") ;;
            --top)     args+=("-n") ;;
            --json)    args+=("-j") ;;
            *)         args+=("${arg}") ;;
        esac
    done

    # getopts で短いオプションを解析（結合オプション対応: -mj など）
    OPTIND=1
    while getopts ":hvmjn:" opt "${args[@]}"; do
        case "${opt}" in
            h)
                usage_helper "$0"
                exit 0
                ;;
            v)
                print_version
                exit 0
                ;;
            m) sort_key="mem" ;;
            j) output_format="json" ;;
            n) top_n="${OPTARG}" ;;
            :)
                echo "Error: option -${OPTARG} requires an argument." >&2
                exit 1
                ;;
            \?)
                echo "Error: unknown option: -${OPTARG}" >&2
                echo "Use --help for usage information." >&2
                exit 1
                ;;
        esac
    done
    shift $((OPTIND - 1))

    # 残りの引数があればエラー
    if [[ $# -gt 0 ]]; then
        echo "Error: unexpected argument: $1" >&2
        echo "Use --help for usage information." >&2
        exit 1
    fi

    if [[ -n "${top_n}" ]] && ! [[ "${top_n}" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: -n requires a positive integer, got: ${top_n}" >&2
        exit 1
    fi

    local cmd
    for cmd in ps nproc getent awk; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "Error: required command not found: ${cmd}" >&2
            exit 1
        fi
    done

    local cores
    if ! cores="$(nproc)"; then
        echo "Error: failed to get CPU core count" >&2
        exit 1
    fi

    local sort_field
    case "${sort_key}" in
        cpu) sort_field=2 ;;
        mem) sort_field=3 ;;
    esac

    # head は SIGPIPE で pipefail を踏むため、件数制限は awk で行う
    collect_usage "${cores}" \
        | sort -t '|' -k "${sort_field},${sort_field}" -nr \
        | awk -v n="${top_n:-0}" 'n == 0 || NR <= n' \
        | case "${output_format}" in
              table) output_table ;;
              json) output_json ;;
          esac
}

main "$@"
