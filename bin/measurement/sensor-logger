#!/bin/bash
# -----------------------------------------------------------------------------
# Author: Ryo Nakagami
# Revised: 2026-06-05
# Script: sensor-logger
# Description:
#   Continuously records hardware sensor temperatures to a JSONL log file.
#   Each line is a JSON object with a datetime stamp and temperature readings
#   for CPU (Tctl, Tccd1, Tccd2), GPU (edge), and NVMe drives.
#
#   On startup, any previous JSONL log files in the log directory are
#   compressed with gzip so only the current session remains uncompressed.
#
#   On exit (SIGINT / SIGTERM), the script compresses the current log file.
#
#   Log location (default): ~/.log/sensors/sensor-temperature_<TIMESTAMP>.jsonl
#
# Options:
#   -i <sec>      Sampling interval in seconds (default: 1)
#   -d <dir>      Log directory (default: ~/.log/sensors)
#   -h            Show this help message
#
# Usage:
#   sensor-logger                        # log every second to default directory
#   sensor-logger -i 5                   # log every 5 seconds
#   sensor-logger -d /tmp/sensors        # write logs to /tmp/sensors
#   nohup sensor-logger &> /dev/null &   # run in background, survives logout
#   nohup sensor-logger -i 5 & disown    # background + detach from shell job table
#   pgrep -a -f sensor-logger            # show PID and full command of running instance
#   zcat <logfile>.jsonl.gz | jq .       # view compressed logs with jq
# Notes:
#   - Requires 'sensors' (lm-sensors), 'gzip', 'awk', and 'grep'.
#   - Sources '../../lib/docstring.sh' for usage_helper.
# -----------------------------------------------------------------------------

set -uo pipefail

# ---- Load dependencies ----
# shellcheck source=../../lib/docstring.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../lib/docstring.sh"

# ---- Check required commands ----
for cmd in sensors gzip awk grep; do
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    printf 'Error: required command not found: %s\n' "${cmd}" >&2
    exit 1
  fi
done

# ---- Defaults ----
INTERVAL=1
LOG_DIR="${HOME}/.log/sensors"

# ---- Parse options ----
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h)
      usage_helper "$0"
      exit 0
      ;;
    -i)
      if [[ $# -lt 2 ]]; then
        printf 'Error: -i requires a value.\n' >&2
        usage_helper "$0"
        exit 1
      fi
      INTERVAL="$2"
      if ! [[ "${INTERVAL}" =~ ^[0-9]+$ ]] || [[ "${INTERVAL}" -lt 1 ]]; then
        printf 'Error: -i must be a positive integer.\n' >&2
        exit 1
      fi
      shift 2
      ;;
    -d)
      if [[ $# -lt 2 ]]; then
        printf 'Error: -d requires a value.\n' >&2
        usage_helper "$0"
        exit 1
      fi
      LOG_DIR="$2"
      shift 2
      ;;
    -*)
      printf 'Error: unknown option: %s\n' "$1" >&2
      usage_helper "$0"
      exit 1
      ;;
    *)
      printf 'Error: unexpected argument: %s\n' "$1" >&2
      usage_helper "$0"
      exit 1
      ;;
  esac
done

# ---- Setup log file ----
mkdir -p "${LOG_DIR}"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
LOG_FILE="${LOG_DIR}/sensor-temperature_${TIMESTAMP}.jsonl"

# ---- Compress old logs ----
while IFS= read -r -d '' old_file; do
  gzip "${old_file}"
done < <(find "${LOG_DIR}" -maxdepth 1 -name 'sensor-temperature_*.jsonl' \
           ! -name "$(basename "${LOG_FILE}")" -print0)

# ---- Cleanup on exit ----
_cleanup() {
  if [[ -f "${LOG_FILE}" && -s "${LOG_FILE}" ]]; then
    gzip "${LOG_FILE}"
    printf '\nLog compressed: %s.gz\n' "${LOG_FILE}"
  fi
  exit 0
}
trap '_cleanup' INT TERM

printf 'Logging to %s  (interval: %ds)  Ctrl-C to stop.\n' "${LOG_FILE}" "${INTERVAL}"

# ---- Helper: extract a single numeric temperature ----
# Usage: _extract_temp <sensors_output_var> <awk_pattern>
_extract_temp() {
  local pattern="$1"
  local out
  out=$(printf '%s\n' "${SENSOR_OUT}" | awk "${pattern}")
  printf '%s' "${out:-null}"
}

# ---- Main loop ----
while true; do
  SENSOR_OUT=$(sensors 2>/dev/null)

  DATETIME=$(date +"%Y-%m-%dT%H:%M:%S")

  CPU_TCTL=$(printf '%s\n'  "${SENSOR_OUT}" | awk '/Tctl/{gsub(/[^0-9.+-]/,"",$2); print $2; exit}')
  CPU_TCCD1=$(printf '%s\n' "${SENSOR_OUT}" | awk '/Tccd1/{gsub(/[^0-9.+-]/,"",$2); print $2; exit}')
  CPU_TCCD2=$(printf '%s\n' "${SENSOR_OUT}" | awk '/Tccd2/{gsub(/[^0-9.+-]/,"",$2); print $2; exit}')
  GPU_EDGE=$(printf '%s\n'  "${SENSOR_OUT}" | awk '/^edge/{gsub(/[^0-9.+-]/,"",$2); print $2; exit}')
  NVME0=$(printf '%s\n'     "${SENSOR_OUT}" | grep -A5 'nvme-pci-0500' \
            | awk '/Composite/{gsub(/[^0-9.+-]/,"",$2); print $2; exit}')
  NVME1=$(printf '%s\n'     "${SENSOR_OUT}" | grep -A5 'nvme-pci-0200' \
            | awk '/Composite/{gsub(/[^0-9.+-]/,"",$2); print $2; exit}')

  printf '{"datetime":"%s","cpu":{"tctl":%s,"tccd1":%s,"tccd2":%s},"gpu":{"edge":%s},"nvme":{"nvme0":%s,"nvme1":%s}}\n' \
    "${DATETIME}" \
    "${CPU_TCTL:-null}" \
    "${CPU_TCCD1:-null}" \
    "${CPU_TCCD2:-null}" \
    "${GPU_EDGE:-null}" \
    "${NVME0:-null}" \
    "${NVME1:-null}" \
    >> "${LOG_FILE}"

  sleep "${INTERVAL}"
done
