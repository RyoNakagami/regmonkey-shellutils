#!/bin/bash
# -----------------------------------------------------------------------------
# Author: Ryo Nakagami
# Revised: 2026-06-03
# Script: fast-du
# Description:
#   Quickly displays disk usage for each item in a target directory,
#   leveraging parallel processing for speed.
#
#   Steps:
#     1. Check required external commands.
#     2. Parse options for parallelism and help.
#     3. Validate parallelism value and the target directory.
#     4. Use 'find' to list items in the directory.
#     5. Run 'du -sh' on each item in parallel.
#     6. Sort results by human-readable size.
#
# Options:
#    -P <num>  Set number of parallel processes (default: half CPU cores)
#    -h        Show this help message
#
# Usage:
#   ./fast-du <TARGET_DIR>          # Show disk usage per item
#   ./fast-du -P 8 <TARGET_DIR>     # Use 8 parallel du processes
#
# Notes:
#   - Requires 'find', 'xargs', 'du', 'sort', and 'getconf' installed.
#   - Items unreadable by the current user are skipped silently;
#     if you need sudo, use: sudo $(which fast-du)
#   - Sources '../../lib/docstring.sh' for usage_helper.
# -----------------------------------------------------------------------------

set -euo pipefail

# ---- Load dependencies ----
# shellcheck source=../../lib/docstring.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../lib/docstring.sh"

# ---- Check required commands ----
for cmd in find xargs du sort getconf; do
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "Error: required command not found: ${cmd}" >&2
    exit 1
  fi
done

# ---- Default values ----
CPU_CORES=$(getconf _NPROCESSORS_ONLN)
DEFAULT_P=$((CPU_CORES / 2))
[ "${DEFAULT_P}" -lt 1 ] && DEFAULT_P=1

PARALLEL="${DEFAULT_P}"
TARGET_DIR=""

# ---- Parse options ----
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h)
      usage_helper
      exit 0
      ;;
    -P)
      if [[ $# -lt 2 ]]; then
        echo "Error: -P requires a value." >&2
        usage_helper
        exit 1
      fi
      PARALLEL="$2"
      shift 2
      ;;
    -*)
      echo "Error: unknown option: $1" >&2
      usage_helper
      exit 1
      ;;
    *)
      if [[ -n "${TARGET_DIR}" ]]; then
        echo "Error: too many arguments: $1" >&2
        usage_helper
        exit 1
      fi
      TARGET_DIR="$1"
      shift
      ;;
  esac
done

# ---- Validate ----
if ! [[ "${PARALLEL}" =~ ^[1-9][0-9]*$ ]]; then
  echo "Error: -P must be a positive integer: ${PARALLEL}" >&2
  exit 1
fi

if [[ -z "${TARGET_DIR}" ]]; then
  echo "Error: TARGET_DIR is required." >&2
  usage_helper
  exit 1
fi

if [[ ! -d "${TARGET_DIR}" ]]; then
  echo "Error: not a directory: ${TARGET_DIR}" >&2
  exit 1
fi

# ---- Run ----
# '|| true' keeps the pipeline alive when du fails on unreadable items
# (xargs would otherwise exit 123 and trip pipefail).
find "${TARGET_DIR}" -mindepth 1 -maxdepth 1 -print0 \
  | { xargs -0 -r -n1 -P"${PARALLEL}" du -sh 2>/dev/null || true; } \
  | sort -h
