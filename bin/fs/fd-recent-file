#!/bin/bash
# -----------------------------------------------------------------------------
# Author: Ryo Nakagami
# Revised: 2026-07-01
# Script: fd-recent-file
# Description:
#   Searches for files under a given directory with depth and regex filtering,
#   then prints only those whose modification time falls within an optional
#   [after, before) time window.
#
#   Steps:
#     1. Parse command-line options (long options are mapped to short ones).
#     2. Validate required arguments and check external dependencies.
#     3. Resolve the -a (after) / -b (before) bounds to epoch seconds.
#     4. Search with 'fd' (fdfind) and keep files with after <= mtime < before.
#     5. Print each matching file with its modification timestamp (ISO 8601).
#
# Options:
#   -s <pattern>   File name pattern (regex). Required.
#   -p <path>      Search path (root directory). Required.
#   -d <depth>     Search depth (default: 5).
#   -a <after>     Lower bound. Print files modified on or after this instant.
#                    - Not specified       -> now
#                    - Nd                  -> N days ago (e.g., "7d")
#                    - Relative expression -> any GNU `date -d` phrase
#                                             (e.g., "2 hours ago", "1 week ago")
#                    - YYYY-MM-DD          -> explicit date
#                    - Timestamp           -> explicit datetime
#                                             (e.g., "2025-01-06 14:30:00")
#                    - Empty string ("")   -> no lower bound
#                  (-t is accepted as a deprecated alias for -a.)
#   -b <before>    Upper bound. Print files modified strictly before this
#                  instant. Same value formats as -a. Default: no upper bound.
#   -v, --version  Show version and exit.
#   -h, --help     Show this help message and exit.
#
# Usage:
#   # Find YAML files updated in the last 7 days under ./src
#   ./fd-recent-file -s "\.yml$" -p ./src -a 7d
#
#   # Find files updated in the last 2 hours
#   ./fd-recent-file -s "\.log$" -p ./var -a "2 hours ago"
#
#   # Find .py files updated since a specific timestamp in /project
#   ./fd-recent-file -s "\.py$" -p /project -a "2025-01-06 14:30:00"
#
#   # Find files updated more than 7 days ago (older than a week)
#   ./fd-recent-file -s "\.log$" -p ./var -a "" -b "7 days ago"
#
#   # Find files updated within a specific window
#   ./fd-recent-file -s "\.py$" -p /project -a "2025-01-01" -b "2025-02-01"
#
# Notes:
#   - Requires 'fd' (fdfind), plus GNU coreutils (stat, date) and 'column'.
#   - Set FD_BIN to override the fd binary (e.g. 'fd' vs 'fdfind'); by default
#     it prefers 'fdfind' and falls back to 'fd'.
#   - Prints files whose modification time is in [after, before).
#   - Sources '../../lib/docstring.sh' and '../../lib/version.sh'.
# -----------------------------------------------------------------------------

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../lib/docstring.sh
source "${SCRIPT_DIR}/../../lib/docstring.sh"
# shellcheck source=../../lib/version.sh
source "${SCRIPT_DIR}/../../lib/version.sh"

# Resolve the fd binary: honour FD_BIN, else prefer fdfind, else fd.
resolve_fd_bin() {
  if [[ -n "${FD_BIN:-}" ]]; then
    printf '%s\n' "${FD_BIN}"
    return 0
  fi
  if command -v fdfind >/dev/null 2>&1; then
    printf '%s\n' "fdfind"
    return 0
  fi
  if command -v fd >/dev/null 2>&1; then
    printf '%s\n' "fd"
    return 0
  fi
  return 1
}

# Parse a reference expression (Nd | relative | date | timestamp) to epoch
# seconds. Prints the epoch seconds on STDOUT; exits non-zero on parse failure.
parse_ref() {
  local val="$1" flag="$2"
  if [[ "${val}" =~ ^[0-9]+d$ ]]; then
    # e.g., "7d" = 7 days ago
    date -d "${val%d} days ago" +%s
  elif ! date -d "${val}" +%s 2>/dev/null; then
    # any GNU `date -d` phrase: relative ("2 hours ago"),
    # explicit date (YYYY-MM-DD) or timestamp ("YYYY-MM-DD HH:MM:SS")
    echo "Error: could not parse ${flag} value: '${val}'" >&2
    echo "       Use 'Nd', a relative phrase (e.g. '2 hours ago'), a date, or a timestamp." >&2
    return 1
  fi
}

# Filter and print files from a NUL-separated stream, keeping those whose mtime
# is within [after, before). Empty after/before means that bound is unset.
# Arguments: $1 = after epoch (or ""), $2 = before epoch (or "").
filter_by_mtime() {
  local after="$1" before="$2"
  local file ts
  while IFS= read -r -d '' file; do
    ts=$(stat -c %Y "${file}")
    if [[ -n "${after}" && "${ts}" -lt "${after}" ]]; then
      continue
    fi
    if [[ -n "${before}" && "${ts}" -ge "${before}" ]]; then
      continue
    fi
    printf '%s  %s\n' "${file}" "$(date -d "@${ts}" +"%Y-%m-%dT%H:%M:%S%z")"
  done
}

main() {
  local depth=5
  local pattern=""
  local search_path=""
  local after_date=""
  local before_date=""
  local after_set=0
  local before_set=0

  # 長いオプションを短いオプションに変換
  local args=()
  local arg
  for arg in "$@"; do
    case "${arg}" in
      --help)    args+=("-h") ;;
      --version) args+=("-v") ;;
      *)         args+=("${arg}") ;;
    esac
  done

  OPTIND=1
  local opt
  while getopts ":s:d:p:a:t:b:hv" opt "${args[@]}"; do
    case "${opt}" in
      s) pattern="${OPTARG}" ;;
      d) depth="${OPTARG}" ;;
      p) search_path="${OPTARG}" ;;
      a|t) after_date="${OPTARG}"; after_set=1 ;;
      b) before_date="${OPTARG}"; before_set=1 ;;
      h)
        usage_helper "$0"
        exit 0
        ;;
      v)
        print_version
        exit 0
        ;;
      :)
        echo "Error: option -${OPTARG} requires an argument." >&2
        echo "Use --help for usage information." >&2
        exit 1
        ;;
      \?)
        echo "Error: unknown option: -${OPTARG}" >&2
        echo "Use --help for usage information." >&2
        exit 1
        ;;
    esac
  done
  shift $((OPTIND - 1))

  # 残りの引数があればエラー
  if [[ $# -gt 0 ]]; then
    echo "Error: unexpected argument: $1" >&2
    echo "Use --help for usage information." >&2
    exit 1
  fi

  # check required args
  if [[ -z "${pattern}" || -z "${search_path}" ]]; then
    echo "Error: -s (file_pattern) and -p (search_path) are required." >&2
    echo "Use --help for usage information." >&2
    exit 1
  fi

  # validate depth
  if ! [[ "${depth}" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: -d must be a positive integer: ${depth}" >&2
    exit 1
  fi

  # validate search path
  if [[ ! -d "${search_path}" ]]; then
    echo "Error: not a directory: ${search_path}" >&2
    exit 1
  fi

  # check dependencies
  local cmd
  for cmd in stat date column; do
    if ! command -v "${cmd}" >/dev/null 2>&1; then
      echo "Error: required command not found: ${cmd}" >&2
      exit 1
    fi
  done

  local fd_bin
  if ! fd_bin="$(resolve_fd_bin)"; then
    echo "Error: required command not found: fd (fdfind)" >&2
    exit 1
  fi
  if ! command -v "${fd_bin}" >/dev/null 2>&1; then
    echo "Error: fd binary not found: ${fd_bin}" >&2
    exit 1
  fi

  # lower bound (after): default = now, empty value = no lower bound
  local after_ts
  if [[ "${after_set}" -eq 0 ]]; then
    after_ts=$(date +%s)
  elif [[ -z "${after_date}" ]]; then
    after_ts=""   # explicit -a "" -> no lower bound
  else
    after_ts=$(parse_ref "${after_date}" "-a")
  fi

  # upper bound (before): default = none
  local before_ts=""
  if [[ "${before_set}" -eq 1 && -n "${before_date}" ]]; then
    before_ts=$(parse_ref "${before_date}" "-b")
  fi

  # validate window
  if [[ -n "${after_ts}" && -n "${before_ts}" && "${after_ts}" -ge "${before_ts}" ]]; then
    echo "Error: -a (${after_date}) is not before -b (${before_date}); empty window." >&2
    exit 1
  fi

  # run search: keep files with after_ts <= mtime < before_ts (bounds optional)
  "${fd_bin}" -d "${depth}" -t f --regex "${pattern}" "${search_path}" -0 \
    | filter_by_mtime "${after_ts}" "${before_ts}" \
    | column -t
}

main "$@"
