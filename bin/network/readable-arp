#!/bin/bash
# -----------------------------------------------------------------------------
# Author: Ryo Nakagami
# Revised: 2026-07-01
# Script: readable-arp
# Description:
#   Display the ARP table in human-readable YAML, resolving MAC addresses to
#   friendly names via a YAML lookup file.
#
#   Steps:
#     1. Parse command-line options (-f/--file, -v/--version, -h/--help).
#     2. Verify required commands (arp, yamlcli, jq).
#     3. Build a MAC-to-name map from the YAML lookup file.
#     4. Print each ARP entry as a YAML block, substituting the name where known.
#
# Options:
#   -f, --file FILE   Path to the MAC address YAML table.
#                     Defaults to $MAC_ADDRESS_TABLE when unset.
#   -v, --version     Show version and exit.
#   -h, --help        Show this help message and exit.
#
# Usage:
#   readable-arp
#   readable-arp -f /etc/mac-table.yaml
#
# Notes:
#   - Requires arp, yamlcli, and jq.
#       arp      : reads the kernel ARP table (net-tools package).
#       yamlcli  : converts YAML to JSON; install via uv tool install yamlcli.
#       jq       : JSON processor for MAC-to-name lookup.
#   - MAC address YAML format:
#       interfaces:
#         - mac: "aa:bb:cc:dd:ee:ff"
#           name: "my-device"
#   - MAC_ADDRESS_TABLE env var sets the default lookup file path.
#   - Sources '../../lib/docstring.sh' and '../../lib/version.sh'.
# -----------------------------------------------------------------------------

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../../lib/docstring.sh"
source "${SCRIPT_DIR}/../../lib/version.sh"

# ---- Default values ----
MAC_TABLE="${MAC_ADDRESS_TABLE:-}"

# ---- Parse options ----
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage_helper "$0"
            exit 0
            ;;
        -v|--version)
            print_version
            exit 0
            ;;
        -f|--file)
            if [[ -z "${2:-}" ]]; then
                echo "Error: $1 requires an argument" >&2
                echo "Use --help for usage information." >&2
                exit 1
            fi
            MAC_TABLE="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Error: unknown option: $1" >&2
            echo "Use --help for usage information." >&2
            exit 1
            ;;
        *)
            echo "Error: unexpected argument: $1" >&2
            echo "Use --help for usage information." >&2
            exit 1
            ;;
    esac
done

# ---- Validate ----
for cmd in arp yamlcli jq; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: required command not found: $cmd" >&2
        exit 1
    fi
done

if [[ -z "$MAC_TABLE" ]]; then
    echo "Error: MAC address table is not set (use -f or set MAC_ADDRESS_TABLE)" >&2
    exit 1
fi

if [[ ! -f "$MAC_TABLE" ]]; then
    echo "Error: MAC address table not found: $MAC_TABLE" >&2
    exit 1
fi

# ---- Run ----

# Build MAC→name map as a compact JSON object: {"aa:bb:...": "name", ...}
mac2name="$(yamlcli --to-json "$MAC_TABLE" | jq -c '
    [.interfaces[] | {(.mac | gsub(" "; "")): .name}] | add // {}
')"

# Print each ARP entry as a YAML block, resolving MAC to name where possible.
# `|| true` prevents grep-no-match from triggering set -e.
arp -n | tail -n +2 | while IFS= read -r line; do
    read -r addr hwtype mac flags iface <<< "$(awk '{print $1, $2, $3, $4, $NF}' <<< "$line")"
    name="$(jq -r --arg m "$mac" '.[$m] // $m' <<< "$mac2name")"
    printf -- "- address: %s\n  name:    %s\n  mac:     %s\n  hwtype:  %s\n  flags:   %s\n  iface:   %s\n" \
        "$addr" "$name" "$mac" "$hwtype" "$flags" "$iface"
done
