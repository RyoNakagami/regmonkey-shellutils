#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Author: Ryo Nakagami
# Revised: 2026-06-02
# Script: generate-headline
# Description:
#   Rephrase the input text in three different directions: shortened,
#   tightened with a noun-phrase ending (体言止め), and slide-headline style.
#   Uses claude-stdin-prompt or codex-stdin-prompt as the backend.
#
#   echo "要約したい文章" | generate-headline
#   generate-headline "要約したい文章"
#   generate-headline < input.txt
#   echo "テキスト" | generate-headline --codex --model o4-mini
#
#   Steps:
#     1. Parse options and take the input text from an argument or stdin.
#     2. Build a prompt requesting N candidates for each of the three
#        directions, in a fixed markdown layout.
#     3. Pass the input to the backend (claude|codex) on stdin and run it.
#
# Options:
#   --codex                   Use codex-stdin-prompt (default: claude-stdin-prompt)
#   --model, -m <model>       Model to use
#                             claude default: sonnet
#                             codex default: (codex's own default)
#   --candidate, -n <number>  Candidates per direction (default: 3)
#   -h, --help                Show this help message
#
# Usage:
#   generate-headline [options] TEXT
#   <command> | generate-headline [options]
#
# Notes:
#   - Supply the input text either as an argument or via a pipe/redirect on
#     stdin.
#   - With --codex, do not start it with stdin attached to a TTY (a codex
#     constraint).
#   - Sources '../../lib/docstring.sh' for usage_helper.
# -----------------------------------------------------------------------------

set -euo pipefail

# ---- Load dependencies ----
# shellcheck source=../../lib/docstring.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../lib/docstring.sh"

# ---- Default values ----
USE_CODEX=false
MODEL=""
CANDIDATE=3
POSITIONAL=()

# ---- Parse options ----
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage_helper
            exit 0
            ;;
        --codex)
            USE_CODEX=true
            shift
            ;;
        --model|-m)
            [[ $# -ge 2 ]] || { echo "Error: $1 requires an argument." >&2; exit 1; }
            MODEL="$2"
            shift 2
            ;;
        --model=*|-m=*)
            MODEL="${1#*=}"
            shift
            ;;
        --candidate|-n)
            [[ $# -ge 2 ]] || { echo "Error: $1 requires an argument." >&2; exit 1; }
            CANDIDATE="$2"
            shift 2
            ;;
        --candidate=*|-n=*)
            CANDIDATE="${1#*=}"
            shift
            ;;
        --)
            shift
            POSITIONAL+=("$@")
            break
            ;;
        -*)
            echo "Error: unknown option: $1" >&2
            exit 1
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

# ---- Validate --candidate ----
[[ "$CANDIDATE" =~ ^[1-9][0-9]*$ ]] || {
    echo "Error: --candidate must be a positive integer, got: $CANDIDATE" >&2
    exit 1
}

# ---- 入力取得 (引数 or stdin) ----
if [[ ${#POSITIONAL[@]} -gt 0 ]]; then
    INPUT="${POSITIONAL[*]}"
    STDIN_SOURCE="arg"
else
    INPUT=""
    STDIN_SOURCE="stdin"
fi

if [[ "$STDIN_SOURCE" == "arg" && -z "${INPUT// /}" ]]; then
    echo "Error: 入力が空です" >&2
    exit 1
fi

# ---- プロンプト本文 ----
PROMPT="あなたはプロフェッショナルビジネスコンサルタントです。以下の文章を、3つの異なる方向性で簡潔にまとめてください。

【方向性】
1. **短くする方向**: 元の意味を保ったまま文字数を削る。語順や接続をそのまま、冗長な部分だけ落とす。
2. **体言止めで引き締める方向**: 文末を体言止め・名詞句にして硬く・密度高く。
3. **スライドの見出しっぽく**: 一目で意味が掴めるキャッチー短文。記号(=、≒、→ など)や対比構造も活用可。

各方向につき${CANDIDATE}案ずつ提示してください。出力は以下の形式で、前置き・後書きは一切不要です。

## 短くする方向
- 案1
- 案2

## 体言止めで引き締める方向
- 案1
- 案2

## スライドの見出しっぽく
- 案1
- 案2"

# ---- バックエンド選択 ----
if $USE_CODEX; then
    AGENT="$(dirname "${BASH_SOURCE[0]}")/codex-stdin-prompt"
else
    AGENT="$(dirname "${BASH_SOURCE[0]}")/claude-stdin-prompt"
fi

[[ -x "$AGENT" ]] || { echo "Error: agent not found or not executable: $AGENT" >&2; exit 1; }

AGENT_ARGS=(-p "$PROMPT")
[[ -n "$MODEL" ]] && AGENT_ARGS+=(--model "$MODEL")

# ---- 呼び出し ----
if [[ "$STDIN_SOURCE" == "arg" ]]; then
    echo "$INPUT" | "$AGENT" "${AGENT_ARGS[@]}"
else
    "$AGENT" "${AGENT_ARGS[@]}"
fi
