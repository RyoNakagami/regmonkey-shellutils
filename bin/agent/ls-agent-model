#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Author: Ryo Nakagami
# Revised: 2026-08-20
# Script: ls-agent-model
# Description:
#   List the models available to coding agents. By default it prints only the
#   model slugs reported by the codex CLI, one per line; with --json it prints
#   JSON that joins in the token prices from config/agent_model_cost.yml (the
#   unit lands in each model's cost_type field).
#
#     ls-agent-model              # slugs only
#     ls-agent-model --json       # slug + prices + pricing metadata (JSON)
#     ls-agent-model -a           # include models marked as hidden
#
#   Steps:
#     1. Parse options and determine the target provider (codex|claude).
#     2. Collect the available slugs from 'codex debug models --bundled'.
#     3. With --json, join the prices from config/agent_model_cost.yml on slug
#        and emit JSON alongside the pricing tier, retrieval date, and source.
#
# Options:
#   -a, --all         Include models that codex marks as 'hide'
#   -j, --json        Emit JSON including prices and pricing metadata
#                     (tier / retrieval date / source)
#   --claude          Target Claude models (not implemented)
#   -v, --version     Print the version and exit
#   -h, --help        Show this help message and exit
#
# Usage:
#   ls-agent-model [options]
#
#   ls-agent-model                # enumerate the available slugs
#   ls-agent-model --json         # JSON with prices
#   ls-agent-model -aj            # JSON with prices, hidden models included
#
#   # Reshape freely with jq (this script does no display formatting)
#   ls-agent-model --json | jq -r '.models[] | [.slug, .price.short.input] | @tsv'
#
# Notes:
#   - Requires 'codex', 'yamlcli', 'jq'.
#   - "Available models" comes from the codex CLI and "prices" come from
#     config/agent_model_cost.yml; the two are joined on slug. A model the CLI
#     returns but the price table omits therefore gets an empty price, and a
#     model in the price table that the CLI does not return never appears in
#     the listing.
#   - The nested structure under price is returned exactly as written in the
#     config. Price tables differ in shape per provider (OpenAI has two levels
#     for short/long context, Anthropic is flat input/output), so the structure
#     is neither interpreted nor normalized.
#   - The price unit goes in each model's cost_type (e.g. "USD / 1M tokens").
#     A model's own cost_type in the config wins; otherwise the provider's unit
#     is used. The value is already resolved, so callers need no branching.
#   - The JSON also carries the pricing tier (pricing_tier), the date the
#     prices were transcribed (retrieved), and the source URL (source), all
#     emitted verbatim from the config. Prices get revised, so always consult
#     the source URL as the basis for any billing claim.
#   - --claude is planned for a future release; specifying it currently exits
#     with an error.
#   - The config file is resolved relative to this script
#     (config/agent_model_cost.yml). It can be overridden with the CONFIG_FILE
#     environment variable.
#   - Sources '../../lib/docstring.sh' and '../../lib/version.sh'.
# -----------------------------------------------------------------------------

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../lib/docstring.sh
source "${SCRIPT_DIR}/../../lib/docstring.sh"
# shellcheck source=../../lib/version.sh
source "${SCRIPT_DIR}/../../lib/version.sh"

# config/agent_model_cost.yml はこのスクリプトからの相対で解決する．
# CONFIG_FILE / CODEX_BIN はテストから差し替えるための seam．
CONFIG_FILE="${CONFIG_FILE:-${SCRIPT_DIR}/config/agent_model_cost.yml}"
CODEX_BIN="${CODEX_BIN:-codex}"

# 参照する config 上のプロバイダ．--claude 実装時に 'anthropic' へ切り替える．
PROVIDER="openai"

# codex が報告するモデルを {slug, display_name, visibility} の JSON 配列で返す．
# 引数が 0 のときは visibility == "list" のものだけに絞る．
fetch_codex_models() {
    local include_hidden="$1"
    "${CODEX_BIN}" debug models --bundled \
        | jq --argjson all "${include_hidden}" '
            [ .models[]
              | select($all == 1 or .visibility == "list")
              | {slug, display_name, visibility}
            ]'
}

# プロバイダの価格メタ情報（source / retrieved / pricing_tier）を JSON で返す．
provider_meta() {
    local provider="$1"
    yamlcli --to-json "${CONFIG_FILE}" \
        | jq --arg p "${provider}" '
            .[$p] // {}
            | {
                source:       .source,
                retrieved:    .retrieved,
                pricing_tier: .pricing_tier
              }'
}

# codex の一覧に config の単価を slug で結合した JSON 配列を返す．
# 単価が無いモデルも一覧からは落とさず，価格側を空オブジェクトのまま残す．
join_cost() {
    local provider="$1" models_json="$2"
    # YAML の読み込みは1回で済ませ，models と unit をそこから取り出す．
    local provider_json cost_json default_unit
    provider_json="$(yamlcli --to-json "${CONFIG_FILE}" \
        | jq --arg p "${provider}" '.[$p] // {}')"
    cost_json="$(jq '.models // {}' <<< "${provider_json}")"
    default_unit="$(jq -r '.unit // empty' <<< "${provider_json}")"
    jq -n \
        --argjson models "${models_json}" \
        --argjson cost "${cost_json}" \
        --arg unit "${default_unit}" '
        [ $models[]
          | . as $m
          | ($cost[$m.slug] // {}) as $c
          | {
              slug:      $m.slug,
              display:   ($c.display // $m.display_name // $m.slug),
              # 単位はモデル個別の cost_type を優先し，無ければ provider の
              # unit を使う．解決済みの値を入れるので利用側は分岐不要．
              cost_type: ($c.cost_type // (if $unit == "" then null else $unit end)),
              price:     ($c | del(.display, .cost_type))
            }
        ]'
}

main() {
    local include_hidden=0 output_json=0 use_claude=0

    # 長いオプションを短いオプションに変換する（--claude だけは別扱い）．
    local args=() arg
    for arg in "$@"; do
        case "${arg}" in
            --help)    args+=("-h") ;;
            --version) args+=("-v") ;;
            --all)     args+=("-a") ;;
            --json)    args+=("-j") ;;
            --claude)  use_claude=1 ;;
            *)         args+=("${arg}") ;;
        esac
    done

    # --claude を取り除いた後の引数列で改めて解析する（元の "$@" のままだと
    # 後段の余剰引数チェックが --claude を拾ってしまう）．
    set -- ${args[@]+"${args[@]}"}

    OPTIND=1
    if (( $# > 0 )); then
        while getopts ":hvaj" opt "$@"; do
            case "${opt}" in
                h)
                    usage_helper "$0"
                    exit 0
                    ;;
                v)
                    print_version
                    exit 0
                    ;;
                a) include_hidden=1 ;;
                j) output_json=1 ;;
                \?)
                    echo "Error: unknown option: -${OPTARG}" >&2
                    echo "Use --help for usage information." >&2
                    exit 1
                    ;;
            esac
        done
        shift $((OPTIND - 1))
    fi

    if [[ $# -gt 0 ]]; then
        echo "Error: unexpected argument: $1" >&2
        echo "Use --help for usage information." >&2
        exit 1
    fi

    if (( use_claude )); then
        echo "Error: --claude is not implemented yet." >&2
        exit 1
    fi

    local cmd
    for cmd in "${CODEX_BIN}" yamlcli jq; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "Error: required command not found: ${cmd}" >&2
            exit 1
        fi
    done

    if [[ ! -r "${CONFIG_FILE}" ]]; then
        echo "Error: cannot read config file: ${CONFIG_FILE}" >&2
        exit 1
    fi

    local models
    models="$(fetch_codex_models "${include_hidden}")"

    if (( output_json )); then
        # JSON では価格そのものに加え，どの時点のどの区分の価格かを示す
        # メタ情報（pricing_tier / retrieved / source）も返す．
        local joined meta
        meta="$(provider_meta "${PROVIDER}")"
        joined="$(join_cost "${PROVIDER}" "${models}")"
        jq -n --sort-keys \
            --argjson meta "${meta}" \
            --argjson models "${joined}" \
            '{
                pricing_tier: $meta.pricing_tier,
                retrieved:    $meta.retrieved,
                source:       $meta.source,
                models:       $models
             }'
    else
        jq -r '.[].slug' <<< "${models}"
    fi
}

main "$@"
